---
import brand from '../assets/brand.svg?url';
import instagram from '../assets/icons/instagram.svg?url';
import twitter from '../assets/icons/twitter.svg?url';

const social = [
  { name: 'Instagram', href: 'https://instagram.com/levonapp', icon: instagram },
  { name: 'Twitter', href: 'https://twitter.com/levonapp', icon: twitter },
];
---

<footer class="py-12 md:py-24">
  <div class="container">
    <img src={brand} alt="Levon" width="144" height="40" class="mb-2 h-10 w-36" />

    <p class="mb-2 text-[24px] leading-[1.45] tracking-[-0.03em] text-footer">Rent gear, rock on.</p>

    <ul class="mb-8 flex h-[27.2px] gap-[17.8px] md:mb-0">
      {
        social.map(({ name, href, icon }) => (
          <li class="pt-[4.8px]">
            <a href={href} target="_blank" rel="noopener">
              <img src={icon} alt={name} width="20" height="20" class="size-5" />
            </a>
          </li>
        ))
      }
    </ul>

    <p class="mb-2 py-4 text-[15px] leading-[1.45] tracking-[-0.03em] text-footer">
      © <span id="copyright-year">{new Date().getFullYear()}</span> Levon. All Rights Reserved.
    </p>
  </div>
</footer>

<script>
  // Keep the year current between deploys.
  const year = document.getElementById('copyright-year');
  if (year) year.textContent = String(new Date().getFullYear());
</script>
