---
/*
 * Mailchimp waitlist signup. Posts straight to the Levon audience on
 * Mailchimp and opens the confirmation page in a new tab, like the
 * original embed did.
 */
const MAILCHIMP_ACTION =
  'https://app.us17.list-manage.com/subscribe/post?u=6a3cb82526a66f7f4623ece9b&id=20aa27c0ba';
// Honeypot field Mailchimp uses to drop bot signups. Do not remove.
const HONEYPOT = 'b_6a3cb82526a66f7f4623ece9b_20aa27c0ba';
---

<form
  action={MAILCHIMP_ACTION}
  method="post"
  target="_blank"
  name="mc-embedded-subscribe-form"
  id="mc-embedded-subscribe-form"
  class="mb-4"
>
  <div class="mb-6">
    <label for="mce-EMAIL" class="mb-2 inline-block">Email Address</label>
    <input
      type="email"
      name="EMAIL"
      id="mce-EMAIL"
      required
      autocomplete="email"
      placeholder="youremail@emailaddress.com"
      class="block w-full rounded-[6px] border border-field-border bg-white px-5 py-[13px] text-[17px] leading-[1.6] text-field-text placeholder:text-placeholder focus:border-field-focus focus:outline-none"
    />
  </div>
  <div class="absolute -left-[5000px]" aria-hidden="true">
    <input type="text" name={HONEYPOT} tabindex="-1" value="" />
  </div>
  <button
    type="submit"
    name="subscribe"
    id="mc-embedded-subscribe"
    class="block w-full cursor-pointer rounded-lg border border-transparent bg-brand px-5 py-[13px] text-center text-[17px] leading-[1.6] font-semibold tracking-[-0.03em] text-white uppercase"
  >
    Join the Waitlist
  </button>
</form>
